<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Warcross Net</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/kitap_y.styles.css" asp-append-version="true" />
    <style>
        /* Warcross Siberpunk Tema Kümesi */
        body {
            background-color: #0b0c10 !important; /* Derin Gece Siyahı */
            color: #c5c6c7 !important;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        /* Parlayan Sanal Gerçeklik Navbarı */
        .warcross-nav {
            background: linear-gradient(90deg, #0f0c20 0%, #15102a 100%) !important;
            border-bottom: 2px solid #ff007f !important; /* Neon Pembe Çizgi */
            box-shadow: 0 0 15px rgba(255, 0, 127, 0.4);
        }
        /* Neon Yazılar ve Kartlar */
        .neon-text-blue {
            color: #00f0ff !important; /* Elektrik Mavisi */
            text-shadow: 0 0 10px rgba(0, 240, 255, 0.6);
        }
        .neon-text-pink {
            color: #ff007f !important; /* Sanal Gerçeklik Pembesi */
            text-shadow: 0 0 10px rgba(255, 0, 127, 0.6);
        }
        /* Menü Linkleri İçin Neon Parlama Efekti */
        .cyber-link {
            color: #00f0ff !important;
            font-weight: 500;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }
        .cyber-link:hover {
            color: #ff007f !important;
            text-shadow: 0 0 8px rgba(255, 0, 127, 0.8);
        }
        .cyber-card {
            background: rgba(20, 15, 38, 0.8) !important;
            border: 1px solid #00f0ff !important;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.2);
            backdrop-filter: blur(10px);
        }
        /* Warcross Tarzı Kusursuz Buton */
        .cyber-btn {
            background: transparent !important;
            color: #ff007f !important;
            border: 2px solid #ff007f !important;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 0 10px rgba(255, 0, 127, 0.3);
        }
        .cyber-btn:hover {
            background: #ff007f !important;
            color: #05050a !important;
            box-shadow: 0 0 25px #ff007f;
            transform: scale(1.05);
        }
        /* Koyu Footer Ayarı */
        .cyber-footer {
            background-color: #05050a !important;
            border-top: 1px solid #ff007f !important;
            color: #666d7a !important;
            margin-top: auto;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark warcross-nav mb-4">
            <div class="container-fluid">
                <a class="navbar-brand neon-text-pink fw-bold" style="letter-spacing: 2px;" asp-area="" asp-controller="Home" asp-action="Index">YOUNIVERSE</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link cyber-link" asp-area="" asp-controller="Home" asp-action="Index">TERMİNAL</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link cyber-link" asp-area="" asp-controller="Books" asp-action="Index">KÜTÜPHANE</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted cyber-footer py-3">
        <div class="container text-center">
            &copy; 2026 - <span class="neon-text-blue">Warcross Net</span> - Tüm Hakları Sanal Evrende Saklıdır.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>