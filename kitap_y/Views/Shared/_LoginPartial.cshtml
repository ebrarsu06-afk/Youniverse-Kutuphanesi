@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link neon-text-blue fw-bold me-2">MERHABA @User.Identity?.Name!.ToUpper()</a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="btn btn-sm btn-outline-danger fw-bold px-3">ÇIKIŞ YAP</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link fw-bold px-3 me-2" style="color: #00f0ff !important; text-shadow: 0 0 5px rgba(0, 240, 255, 0.5);" asp-area="Identity" asp-page="/Account/Register">KAYIT OL</a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-bold px-3" style="color: #ff007f !important; text-shadow: 0 0 5px rgba(255, 0, 127, 0.5);" asp-area="Identity" asp-page="/Account/Login">GİRİŞ YAP</a>
        </li>
    }
</ul>